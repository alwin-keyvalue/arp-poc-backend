DB_HOST=<host>
DB_PORT=5432
DB_NAME=<database>
DB_USER=<user>
DB_PASSWORD=<password>
DB_SSLMODE=require
DB_SCHEMA=
AZURE_TENANT_ID=<azure-ad-tenant-id-if-the-app-is-single-tenant>
AZURE_CLIENT_ID=<microsoft-app-id-of-your-azure-bot-registration>
AZURE_CLIENT_SECRET=
WEBHOOK_BASE_URL=
WEBHOOK_CLIENT_STATE=
# Only renew Graph subscriptions expiring within N hours. Leave unset to renew all.
SUBSCRIPTION_RENEW_WITHIN_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LLM_PROVIDER=gemini
MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=<key>
# OPENAI_API_KEY=<key>    # when LLM_PROVIDER=openai
# LITELLM_PROXY=https://llm.keyvalue.systems   
TIMEOUT=60
TEMPERATURE=0.0
BOT_APP_PASSWORD=<client-secret-from-azure-bot-certificates-and-secrets>
