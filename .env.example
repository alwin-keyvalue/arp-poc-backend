DB_HOST=<host>
DB_PORT=5432
DB_NAME=<database>
DB_USER=<user>
DB_PASSWORD=<password>
DB_SSLMODE=require
DB_SCHEMA=
# Logs every SQL statement + bound parameters via SQLAlchemy's "sqlalchemy.engine" logger.
# Off by default — noisy, and query params can include things you don't want in logs.
DB_ECHO=false
AZURE_TENANT_ID=<azure-ad-tenant-id-if-the-app-is-single-tenant>
AZURE_CLIENT_ID=<microsoft-app-id-of-your-azure-bot-registration>
# Same Azure AD App Registration secret used for both Graph app-only auth and Bot Framework
# channel auth (Bot Framework calls this the "Microsoft App Password") — one var, not two.
AZURE_CLIENT_SECRET=<client-secret-from-azure-bot-certificates-and-secrets>
WEBHOOK_BASE_URL=
WEBHOOK_CLIENT_STATE=
# Rich Outlook subscription lifetime in minutes (Graph max ~1440 / ~1 day).
MAX_SUBSCRIPTION_MINUTES=1440
# Rich (includeResourceData) Outlook subscriptions — encrypted payload is used for
# from/to/cc whitelist only. Outlook forbids Body in $select, so full content always
# comes from Graph GET after whitelist passes. Subscriptions expire in ~24h — renew often.
# Self-signed RSA 2048+ cert is fine. Accepts: PEM text, base64(PEM), base64(DER), or a file path.
GRAPH_NOTIFICATION_CERTIFICATE_ID=arp-poc-cert-1
GRAPH_NOTIFICATION_CERTIFICATE=./certs/graph-webhook.crt
GRAPH_NOTIFICATION_PRIVATE_KEY=./certs/graph-webhook.key
# Base URL of the deployed arp-poc frontend — used to build the "View task" link on the
# Teams assignment card (e.g. https://arp-poc.vercel.app). Ignored if TEAMS_APP_ID is set.
WEB_APP_URL=
# Teams App ID (from the app's Teams "Share app" link / Developer Portal) — when set, the
# "View task" card button opens as a Teams deep link instead of a plain browser URL.
TEAMS_APP_ID=
# Teams entity id for the Teams deep link (https://teams.microsoft.com/l/entity/{appId}/{entityId}).
TEAMS_ENTITY_ID=arp-poc
# Comma-separated emails to never auto-subscribe for inbox notifications when they add the
# Teams bot (e.g. shared/service mailboxes, test accounts).
SUBSCRIPTION_EXCLUDED_EMAILS=
# Mailbox (userId or UPN) the task status report email is sent "as" via Graph application
# sendMail — that mailbox's Azure AD app registration needs Mail.Send (Application) granted.
REPORTS_SENDER_MAILBOX=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Internal auth secret for the internal API
INTERNAL_AUTH_SECRET=
# How many days back each scheduled mailbox sync run looks; only matters for a user's first
# sync or if a run is missed, since already-processed messages are skipped via a dedup table.
MAILBOX_SYNC_LOOKBACK_DAYS=30

LLM_PROVIDER=gemini
MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=<key>
# OPENAI_API_KEY=<key>    # when LLM_PROVIDER=openai
# LITELLM_PROXY=https://llm.keyvalue.systems
TIMEOUT=60
TEMPERATURE=0.0
# Comma-separated. LLM only runs if from/to/cc/bcc matches a listed address.
# Mailbox owner alone does not count. Leave empty to allow all.
LLM_EMAIL_WHITELIST=
